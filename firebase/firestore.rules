rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------
    // Helpers
    // -----------------------
    function isSignedIn() {
      // Supports anonymous auth (uid present)
      return request.auth != null && request.auth.uid != null;
    }

    // deleted can be boolean true or numeric 1 depending on writer
    function isNotDeleted(res) {
      return !(res.data.deleted == true || res.data.deleted == 1);
    }

    // -----------------------
    // Quizzes collection
    // -----------------------
    match /quizzes/{quizId} {

      // READ (get + list/queries):
      // 1) Global/admin quizzes are visible ONLY when:
      //    is_admin_quiz == true && available_to_all == true &&
      //    is_approved == true && deleted == 0/false
      //
      // 2) (Optional) Private quizzes visible to owner (if you later add owner_id)
      allow get, list: if isSignedIn() && (
        (
          resource.data.is_admin_quiz == true &&
          resource.data.available_to_all == true &&
          resource.data.is_approved == true &&
          isNotDeleted(resource)
        ) || (
          // Owner-only visibility support (for future non-admin quizzes)
          resource.data.owner_id == request.auth.uid &&
          isNotDeleted(resource)
        )
      );

      // WRITE: DISALLOW all client-side writes.
      // Admin SDK (your Flask backend using service account) BYPASSES rules.
      allow create, update, delete: if false;

      // -----------------------
      // 🧩 NEW: Questions subcollection (READ-ONLY for clients)
      // -----------------------
      match /questions/{qid} {
        // Allow reads only if the PARENT quiz is visible under the same constraints
        allow get, list: if isSignedIn() &&
          get(/databases/$(database)/documents/quizzes/$(quizId)).data.is_admin_quiz == true &&
          get(/databases/$(database)/documents/quizzes/$(quizId)).data.available_to_all == true &&
          get(/databases/$(database)/documents/quizzes/$(quizId)).data.is_approved == true &&
          isNotDeleted(get(/databases/$(database)/documents/quizzes/$(quizId)));

        // No client-side writes; Admin SDK only
        allow create, update, delete: if false;
      }
    }

    // -----------------------
    // Attempts collection (future)
    // -----------------------
    // Users can read their own attempts (not deleted)
    // Users can create attempts for themselves (not deleted)
    // No client updates/deletes (server can handle moderation if needed)
    match /attempts/{attemptId} {
      allow get, list: if isSignedIn() &&
        resource.data.user_id == request.auth.uid &&
        !(resource.data.deleted == true || resource.data.deleted == 1);

      allow create: if isSignedIn() &&
        request.resource.data.user_id == request.auth.uid &&
        !(request.resource.data.deleted == true || request.resource.data.deleted == 1);

      allow update, delete: if false;
    }

    // -----------------------
    // Users profile (optional)
    // -----------------------
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
