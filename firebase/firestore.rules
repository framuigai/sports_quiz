// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check authenticated
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper: normalize a "deleted" flag that may be boolean or numeric
    function isNotDeleted(res) {
      return !(res.data.deleted == true || res.data.deleted == 1);
    }

    // -----------------------
    // Quizzes collection
    // -----------------------
    match /quizzes/{quizId} {

      // READ:
      // 1) Admin/global quizzes visible iff:
      //    is_admin_quiz==true AND available_to_all==true AND is_approved==true AND deleted==false
      // 2) Private quizzes visible only to owner_id == uid AND deleted==false
      allow get, list: if isSignedIn() && (
        (
          // admin/global path
          (resource.data.is_admin_quiz == true) &&
          (resource.data.available_to_all == true) &&
          (resource.data.is_approved == true) &&
          isNotDeleted(resource)
        ) ||
        (
          // owner path
          (resource.data.owner_id == request.auth.uid) &&
          isNotDeleted(resource)
        )
      );

      // WRITE:
      // Client writes are blocked (Admin SDK/back-end only).
      allow create, update, delete: if false;
    }

    // -----------------------
    // Attempts collection (optional for later)
    // -----------------------
    match /attempts/{attemptId} {
      allow get, list: if isSignedIn() &&
        resource.data.user_id == request.auth.uid &&
        !(resource.data.deleted == true || resource.data.deleted == 1);

      allow create: if isSignedIn() &&
        request.resource.data.user_id == request.auth.uid &&
        !(request.resource.data.deleted == true || request.resource.data.deleted == 1);

      allow update, delete: if false;
    }

    // Users (optional)
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
